# Environment Variables Example for Secret of Games
# Set these in your Cloudflare Pages dashboard (Settings -> Environment variables) or in local .dev.vars file.

# Stripe Secret API Key (Required for server side)
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Publishable Key (Optional)
STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Webhook Secret (Required for webhook signature verification)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Shipping Rate ID (Default: shr_1TvhlTJKRoSezgT6lCmYqqdN)
SHIPPING_RATE_ID=shr_1TvhlTJKRoSezgT6lCmYqqdN

# Success and Cancel Redirect URLs
SUCCESS_URL=https://secretofgames.com?success=true
CANCEL_URL=https://secretofgames.com?canceled=true
